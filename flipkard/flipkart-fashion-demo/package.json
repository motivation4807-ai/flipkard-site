{
  "name": "flipkart-fashion-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && node scripts/prepare-standalone.cjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "catalog:generate": "python3 scripts/generate_catalog.py",
    "smoke": "python3 scripts/smoke_test.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
